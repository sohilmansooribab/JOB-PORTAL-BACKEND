# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/job_portal

# JWT Authentication (Required - minimum 32 characters in production)
JWT_SECRET=your_jwt_super_secret_key_minimum_32_chars_long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Redis Configuration (Optional - set REDIS_ENABLED=false to use in-memory fallback)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# Cloudinary (Optional - file uploads use local storage if not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
