# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/job_portal

# JWT Authentication
JWT_SECRET=job_portal_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Redis Configuration (Optional - falls back gracefully if Redis is offline)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Cloudinary (Optional - file uploads use local storage if not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
